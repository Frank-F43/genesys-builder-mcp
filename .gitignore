# Cached Genesys Cloud OpenAPI spec, ~22 MB. A reproducible download, not
# source: a committed copy is stale within weeks and weighs down every clone.
# Refresh it with scripts/fetch_api_spec.py.
#
# This lives here rather than in the working repository's root .gitignore so
# that the rule travels into the published copy, where toolkit/ is the root.
reference/swagger/

# Architect action catalog and the SDK it is built from. Rebuilt by
# architect-catalog/refresh.sh, and specific to the org it was built against.
reference/architect/
architect-catalog/node_modules/
architect-catalog/package-lock.json
architect-catalog/package.json
